* text=auto eol=lf

# Kept out of the installed package: a dev dependency is still something every consuming
# project downloads, and none of this is read from vendor/. The library is src/ and bin/,
# plus the three files Composer, an IDE and a license check actually look for.
/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/AGENTS.md          export-ignore
/CLAUDE.md          export-ignore
/PLAN.md            export-ignore
/docs               export-ignore
/examples           export-ignore
/http-vcr.php       export-ignore
/phpstan.neon.dist  export-ignore
/phpunit.xml.dist   export-ignore
/pint.json          export-ignore
/tests              export-ignore
