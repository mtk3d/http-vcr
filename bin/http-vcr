#!/usr/bin/env php
<?php

declare(strict_types=1);

use HttpVcr\Console\Application;

// The host project's autoloader, not this package's: the commands read that project's
// cassettes, and loading ours instead is silent rather than fatal — our vendor/ carries
// symfony/yaml, so the default serializer flips to YAML and every JSON cassette in the host
// project disappears from `scan-secrets` and `providers` without a word about why
// (§7 decision 79).
//
// Composer's generated bin proxy says outright which file that is, so ask it rather than
// counting directories up from here. The two paths are the fallback for a binary invoked
// directly: first the installed-package layout, then our own checkout. Order matters, since
// a path repository produces both at once.
$autoloaders = array_filter([
    $GLOBALS['_composer_autoload_path'] ?? null,
    __DIR__ . '/../../../autoload.php',
    __DIR__ . '/../vendor/autoload.php',
], 'is_string');

foreach ($autoloaders as $autoloader) {
    if (is_file($autoloader)) {
        require $autoloader;

        exit((new Application())->run());
    }
}

fwrite(STDERR, "Could not find the project's vendor/autoload.php. Run composer install first.\n");

exit(1);
